{
  "name": "pipo-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Pipo Music Player para televisores LG con webOS",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && ares-package dist -o out --no-minify"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
